{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ctnascm-learning-os",
  "compatibility_date": "2026-07-13",
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  },
  "vars": {
    "PUBLIC_DEMO": "1"
  }
}
